{
  "name": "copilot-llm-proxy",
  "version": "0.1.1",
  "description": "Local proxy that exposes GitHub Copilot's LLM backend via OpenAI- (chat-completions + responses) and Anthropic-compatible (messages) HTTP APIs. Use Claude Code CLI, Codex CLI, and Codex Desktop with your Copilot subscription.",
  "type": "module",
  "license": "MIT",
  "author": "@heartAndRain",
  "homepage": "https://github.com/heartAndRain/copilot-llm-proxy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heartAndRain/copilot-llm-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/heartAndRain/copilot-llm-proxy/issues"
  },
  "keywords": [
    "github-copilot",
    "copilot",
    "proxy",
    "openai",
    "anthropic",
    "claude-code",
    "codex",
    "llm",
    "cli"
  ],
  "bin": {
    "copilot-llm-proxy": "dist/index.js",
    "cllmp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rimraf dist",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "pack:tgz": "npm pack"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.21.2",
    "smol-toml": "^1.3.1",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public"
  }
}
